# Exchange API Keys (leave blank for simulation mode)
EXCHANGE=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading Mode: paper | live
TRADING_MODE=paper

# Starting Capital (USDT)
STARTING_CAPITAL=10000

# Risk Settings
MAX_RISK_PER_TRADE=0.02        # 2% per trade
MAX_PORTFOLIO_RISK=0.10        # 10% total drawdown limit
MAX_POSITION_SIZE=0.20         # 20% max per position

# Bot Enable/Disable
MEMECOIN_BOT_ENABLED=true
MAINSTREAM_BOT_ENABLED=true
ALPHA_BOT_ENABLED=true

# Capital Allocation (must sum to 1.0)
MEMECOIN_ALLOCATION=0.20
MAINSTREAM_ALLOCATION=0.50
ALPHA_ALLOCATION=0.30

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
